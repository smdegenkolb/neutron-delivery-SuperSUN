      //if (t>0.033) {
      //  t = t - 0.033;
      //}

      //t = 0;
      //p = 0.04 * (atan(-6.62607015e-34/(1.675e-27*sqrt(vx * vx + vy * vy + vz * vz))) / (3.1415/2) + 1);
      RESTORE_NEUTRON(INDEX_CURRENT_COMP, x, y, z, vx, vy, vz, t, sx, sy, sz, p);
