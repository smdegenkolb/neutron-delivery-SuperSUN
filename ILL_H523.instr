*
* %Description
*
* 
* %End
*******************************************************************************/


DEFINE INSTRUMENT ILL_H5()

DECLARE %{
  /* HCS (H5) source  parameters (default values from E. Farhi's 2011 implementation) */
  double t_0 = 0;
  double sT3=413.5,sI3=4.916e12;	
  double sT2=145.8,sI2=1.659e13; 	
  double sT1=40.1,sI1=1.345e13; 	

  double l_mini=0.5;
  double l_maxi=30.5;

  double gSlit = 5.3/1000;
  double gSlit_h = 70/1000;

  /* guide coating parameters */
  double gR0          = 0.99;
  double gQc          = 0.02174;
  double gAlpha       = 2.07;
  double gW           = 0.0025;
  
  double Al_Thickness = 0.001;
  double gGap         = 0.001;

  // GUIDE H5 // 
  double W_5 = 0.17002 ;
  double Lh5 = 1.0;
  // GUIDE H5 //

  // Guide H52 // 
  double m_52 = 3.0;
  double W_52_i = 0.062;
  double W_52_f = 0.120;
  double H_52_i = 0.120;
  double H_52_f = 0.240;
  double L52a = 1.775;
  double L52b = 0.855; 
  double L52c = 1.456;
  double L52d = 0.738; // L52d was changed from 748 -> 738mm based on DPT Dist
  double L52e = 0.4995;
  double L52f = 1.4995;
  double L52g = 1.306;
  double L52h = 1.9975;
  double L52i = 0.9965;
  // Guide H52 ^^

  // Guide H523 // 
  double m_523GEN = 1.2+0.1;
  double m_523LAT = 1.5;

  double W_523_i = 0.055;
  double H_523_i = 0.115;
  double W_523_f = 0.060;
  double H_523_f = 0.120;
  double L523a = 0.9995;
  double L523b = 1.4995;
  double L523c = 0.4995;
  double L523d = 1.2485;
  double L523e = 1.440;
  double L523f = 2.4995;

  // In case a divergence file needs to be used
  char xdiv_file[100];

  /* This is a phenomenological model chosen after spline fits to the best wavelength 
     distribution corrections, it exponentially suppresses long-lambda tail by an 
     amount fit to TOF measurements conducted in 2020. */ 
  double get_scale(double vx, double vy, double vz) {
      double v = sqrt(vx * vx + vy * vy + vz * vz);
      if (v <= 0.0) return 0.0;
      double lambda = 3956.0337 / v;
      if (lambda < 0.0 || lambda >= 30.0) return 0.0;
      
      const double a = 1.9333; 
      const double k = 0.036015; 
      
      double scale = a * exp(-k * lambda); 
      return (scale > 0.0) ? scale : 0.0;
  }

%}

INITIALIZE %{ 

%}

TRACE

/* ================================ H5 =============================== */
COMPONENT Origin = Progress_bar()
AT(0,0,0) ABSOLUTE

// This shifts the source and entrance guide so the following components of the triple guide branch can be conveniently defined as per the listing document 
COMPONENT HCS = Arm()
AT ((0.17002/2 - 0.040 - 0.062/2), 0, 0) RELATIVE Origin 
EXTEND %{
  %}

COMPONENT HorizontalColdSource = Source_gen(
  radius   = 0.21/2,
  zdepth   = 0.15,
  dist     = 2.6,
  focus_xw = W_5,
  focus_yh = 0.120,
  Lmin     = l_mini,
  Lmax     = l_maxi,
  T1       = sT1,
  I1       = sI1,
  T2       = sT2,
  I2       = sI2,
  T3       = sT3,
  I3       = sI3,
  //xdiv_file = "sxd.x_hd",
  verbose  = 1)
  AT ((0.17002/2 - 0.040 - 0.062/2), 0, 0) RELATIVE Origin 
  ROTATED (0, 0, 0) RELATIVE Origin
  EXTEND %{
    // Apply exponential correction, by default scales to reactor power 58.3 MW. Use multiplicative lienar scaling as needed.  
    p = p * get_scale(vx,vy,vz);
    %}

COMPONENT SourceLambda = Monitor_nD(xwidth=1, yheight=1, options="lambda limits =[0 30] bins = 300,  capture, restore_neutron=1, per cm2, filename = Source_Lambda")
AT (0,0,0) RELATIVE PREVIOUS 

COMPONENT SourceXDiv = Monitor_nD(xwidth=1, yheight=1, options="x limits=[-0.105, 0.105] bins 1000 hdiv limits=[-4.2, 4.2] bins 300, parallel, file = SXD")
AT (0,0,0) RELATIVE PREVIOUS 

COMPONENT SourceXDiv2 = Monitor_nD(xwidth=1, yheight=1, options="dx limits=[-5,5] bins 100, capture, per cm2, parallel")
AT (0,0,0) RELATIVE PREVIOUS 

COMPONENT SourceYDiv = Monitor_nD(xwidth=1, yheight=1, options="dx limits=[-5,5] bins 100, capture, per cm2, parallel")
AT (0,0,0) RELATIVE PREVIOUS 

COMPONENT SourceDiv = Monitor_nD(xwidth=1, yheight=1, options="dx limits = [-5,5] bins 100 dy limits=[-5,5] bins 100, capture, per cm2, parallel")
AT (0,0,0) RELATIVE PREVIOUS 

COMPONENT Plaque_Al = Al_window(
    thickness = Al_Thickness)
  AT (0, 0, 0.21) RELATIVE HCS

COMPONENT COPY(Plaque_Al) = COPY(Plaque_Al)
AT (0,0,0.61) RELATIVE HCS

COMPONENT COPY(Plaque_Al) = COPY(Plaque_Al)
AT (0,0,0.78) RELATIVE HCS

COMPONENT COPY(Plaque_Al) = COPY(Plaque_Al)
AT (0,0,0.92) RELATIVE HCS

COMPONENT COPY(Plaque_Al) = COPY(Plaque_Al)
AT (0,0,2.04) RELATIVE HCS
  
COMPONENT H5 = Monitor_nD(xwidth = W_5, yheight=0.12,
  options=" x y,all auto, parallel, bins=50", nowritefile = 1) //remove nowrite
AT(0,0,2.6) RELATIVE HCS
EXTEND %{
  //printf("\n ---------------------");
  //printf("\n Poids particule initial : %f ",p);
%}

COMPONENT H5_L = Monitor_nD( xwidth=W_5, yheight=0.12,
  options="lambda limits =[0.75 30.25] bins = 59 ,per cm2, parallel,  file = Mon_entree_L", nowritefile = 1)
AT (0,0,0) RELATIVE PREVIOUS

COMPONENT H5_L_dx = Monitor_nD( xwidth=W_5, yheight=0.12,
  options="lambda bins = 40 limits = [1 12]  dx bins = 40 limits [-6 6], per cm2, parallel,  file = Mon_entree_Ldx", nowritefile = 1)
AT (0,0,0) RELATIVE PREVIOUS

COMPONENT H5_L_dy = Monitor_nD( xwidth=W_5, yheight=0.12,
  options="lambda bins = 40 limits = [1 12] dy bins = 40 limits [-6 6], per cm2, parallel,  file = Mon_entree_Ldy", nowritefile = 1)
AT (0,0,0) RELATIVE PREVIOUS
  
COMPONENT H5_enpile = Guide(
    w1 = W_5, h1 = 0.120, w2 = W_5, h2 = 0.120, l = 1.0,
   R0 = gR0, Qc = gQc, alpha = 0.9*3, m = 3+0.2, W = gW)
 AT (0, 0, 0) RELATIVE PREVIOUS
 EXTEND %{
      //p = POS_A_COMP(H5_enpile);
      //printf("%f\n",POS_A_COMP(H5_enpile));

  %}

COMPONENT H52_mon = COPY(H5)(
	options =" lambda limits =[0.75 30.25] bins = 59, per cm2,file=H52_e",
	xwidth = W_52_i, restore_neutron = 1)
  AT ( 0, 0, 1.555) RELATIVE H5
	JUMP H52e WHEN SCATTERED


/* Start of guide sections */
////////////////////////////////////////////////////////////////////////////////
/// ================================ H52 ===================================== 
////////////////////////////////////////////////////////////////////////////////
