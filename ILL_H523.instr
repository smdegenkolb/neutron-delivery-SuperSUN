AT (0, 0, 0) RELATIVE PREVIOUS

// The output flux is recorded and saved here
COMPONENT Virtual_MCPL = MCPL_output(
  filename = "upto_oct.mcpl") 
 AT (0, 0, 0) RELATIVE  PREVIOUS

// This filter drops CN incident at overcritical angles to obtain a conservative estimate of UCN production
/*
COMPONENT UCNFilter = Monitor_nD(xwidth=2*0.0371945, restore_neutron = 1, options = "lambda limits =[8.812, 8.917],  bins = 10,  capture, restore_neutron=1, disk, per cm2, filename = UCNFilter") //25mil
  AT (0,0,0.025) RELATIVE PREVIOUS
  EXTEND %{
          double lambda = 1e10 * 6.62607015e-34/(1.675e-27*sqrt(vx * vx + vy * vy + vz * vz));
          double vperp = sqrt(vx*vx + vy*vy);
          double angle = atan(vperp/sqrt(vz*vz));
          double theta_cr = 1.73/1000 * lambda * (3.0-0.22);
          //printf("vperp, vz, angle:%f, %f, %f\n", vperp, vz, angle);

          if (angle > theta_cr && lambda > 8.812 && lambda < 8.917) {
                 ABSORB; 
                 printf("\n\nAbsorbing neutron with theta %f > theta_cr (%f)\n\n", angle, theta_cr);
          }
          //if (angle < theta_cr && lambda > 8.812 && lambda < 8.914) {
          //       printf("Letting neutron through with theta %f < theta_cr (%f)\n", angle, theta_cr);
          //}

    %}
*/

COMPONENT UCNFluxMon = Monitor_nD(xwidth=2*0.0371945,  restore_neutron = 1, options = "lambda limits =[8.812, 8.917],  bins = 10, disk, restore_neutron=1, per cm2, filename = UCNFluxMon") //25mil
  AT (0,0,0.00) RELATIVE PREVIOUS

// ===========================================================
// 8.9A CRITICAL-BAND GATE
// Kills any neutron outside the resonance band before it reaches
// the diagnostic monitors below, so those monitors only ever see
// the gated sub-population.
// ===========================================================
COMPONENT PostOct_UCNBand_Gate = Arm()
  AT (0,0,0) RELATIVE PREVIOUS
EXTEND %{
  double lambda = 1e10 * 6.62607015e-34 / (1.675e-27 * sqrt(vx*vx + vy*vy + vz*vz));
  if (lambda < 8.812 || lambda > 8.917) {
    ABSORB;
  }
%}

// --- Where is the 8.9A population spatially? ------------------
COMPONENT PostOct_Mon_UCNBand_Spatial = Monitor_nD(
  xwidth=0.10, restore_neutron=1, yheight=0.10,
  options="x limits=[-0.045,0.045] bins=90 y limits=[-0.045,0.045] bins=90, per cm2, parallel, filename=PostOct_UCNBand_Spatial")
  AT (0,0,0) RELATIVE PREVIOUS

// --- Where is its momentum directed? ---------------------------
COMPONENT PostOct_Mon_UCNBand_Divergence = Monitor_nD(
  xwidth=0.10, restore_neutron=1, yheight=0.10,
  options="dx limits=[-3,3] bins=100 dy limits=[-3,3] bins=100, parallel, filename=PostOct_UCNBand_Divergence")
  AT (0,0,0) RELATIVE PREVIOUS

// --- Full trace-space, band-gated (position + ITS OWN angle) ---
COMPONENT PostOct_Mon_UCNBand_PhaseSpace_X = Monitor_nD(
  xwidth=0.10, restore_neutron=1, yheight=0.10,
  options="x limits=[-0.03,0.03] bins=100 dx limits=[-3,3] bins=100, per cm2, parallel, filename=PostOct_UCNBand_PhaseSpace_X")
  AT (0,0,0) RELATIVE PREVIOUS

COMPONENT PostOct_Mon_UCNBand_PhaseSpace_Y = Monitor_nD(
  xwidth=0.10, restore_neutron=1, yheight=0.10,
  options="y limits=[-0.045,0.045] bins=100 dy limits=[-3,3] bins=100, per cm2, parallel, filename=PostOct_UCNBand_PhaseSpace_Y")
  AT (0,0,0) RELATIVE PREVIOUS


